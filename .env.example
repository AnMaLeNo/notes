# Copier en `.env` — Chainlit et l'API le chargent automatiquement au démarrage.
GOOGLE_API_KEY=...

# Optionnels
# NOTES_AGENT_MODEL=gemini-3.1-flash-lite
# NOTES_AGENT_THINKING_BUDGET=0   # 0 = pas de réflexion (rapide), -1 = dynamique
# NOTES_AGENT_MAX_RECHERCHES=3

# --- Traçage (optionnel, éteint par défaut) ---------------------------------
# Laisser vide = aucun traçage. L'agent et l'archivage des conversations
# (bouton « Signaler ») fonctionnent entièrement sans. Voir agent/tracing.py :
# c'est le seul fichier à toucher pour changer de backend.
#
# Pour l'activer : pip install -r requirements-tracing.txt, puis décommenter.
# Langfuse auto-hébergé (docker compose, UI sur http://localhost:3000) :
# NOTES_AGENT_TRACING=langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
